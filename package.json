{
  "name": "playdecoder-homepage-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "generate:episode-assets": "node scripts/generate-episode-assets.mjs",
    "generate:episode-cover-fallback": "node scripts/generate-fallback-episode-cover.mjs",
    "generate:podcast-cover": "node scripts/generate-podcast-cover.mjs",
    "generate:podcast-cover:all": "node scripts/generate-podcast-cover.mjs --all",
    "generate:social-post": "node scripts/generate-social-post.mjs",
    "generate:social-post:all": "node scripts/generate-social-post.mjs --all-episodes --all-layouts",
    "generate:format-tokens-css": "node scripts/generate-format-tokens-css.mjs",
    "check": "oxlint --fix . && oxfmt --write .",
    "clean": "bun pm cache rm && rm -rf node_modules bun.lock && bun install"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "botid": "^1.5.12",
    "clsx": "^2.1.1",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "next-intl": {
    "locales": [
      "en",
      "cs"
    ],
    "defaultLocale": "cs",
    "localePrefix": "as-needed"
  }
}
