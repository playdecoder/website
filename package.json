{
  "name": "playdecoder-homepage-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "generate:episode-assets": "node scripts/generate-episode-assets.mjs",
    "generate:episode-cover-fallback": "node scripts/generate-fallback-episode-cover.mjs",
    "generate:podcast-cover": "node scripts/generate-podcast-cover.mjs",
    "generate:podcast-cover:all": "node scripts/generate-podcast-cover.mjs --all",
    "generate:social-post": "node scripts/generate-social-post.mjs",
    "generate:social-post:all": "node scripts/generate-social-post.mjs --all-episodes --all-layouts",
    "check": "oxlint --fix . && oxfmt --write .",
    "clean": "bun pm cache rm && rm -rf node_modules bun.lock && bun install"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "botid": "^1.5.11",
    "clsx": "^2.1.1",
    "next": "^16.2.10",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.0",
    "postcss": "^8.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7.0.2"
  },
  "next-intl": {
    "locales": [
      "en",
      "cs"
    ],
    "defaultLocale": "cs",
    "localePrefix": "as-needed"
  }
}
